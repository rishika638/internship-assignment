# Server Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Providers Configuration
# Supported providers: gemini, openai, claude, mock
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=mock

# Gemini API (Primary recommendation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Mock Mode (Set to true to force deterministic mock responses without API keys)
MOCK_MODE=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_DB_PATH=data/cache.db
CACHE_TTL_SECONDS=86400

# Extraction & Scraping Limits
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
MAX_PAGE_CONTENT_BYTES=1048576
MAX_CRAWL_SUBPAGES=3
